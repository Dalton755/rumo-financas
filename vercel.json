{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/contas",
      "destination": "/index.html"
    },
    {
      "source": "/movimentacoes",
      "destination": "/index.html"
    },
    {
      "source": "/relatorios",
      "destination": "/index.html"
    },
    {
      "source": "/premium",
      "destination": "/index.html"
    },
    {
      "source": "/inteligencia",
      "destination": "/index.html"
    },
    {
      "source": "/metas",
      "destination": "/index.html"
    },
    {
      "source": "/objetivos",
      "destination": "/index.html"
    },
    {
      "source": "/dividas",
      "destination": "/index.html"
    },
    {
      "source": "/projecoes",
      "destination": "/index.html"
    },
    {
      "source": "/orcamento",
      "destination": "/index.html"
    },
    {
      "source": "/alertas",
      "destination": "/index.html"
    },
    {
      "source": "/open-finance",
      "destination": "/index.html"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/index.html"
    },
    {
      "source": "/cartoes",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
